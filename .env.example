# ──────────────────────────────────────────────────────────────
# LetterVault — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ──────────────────────────────────────────────────────────────

# ── Database (Supabase recommended) ──────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lettervault?schema=public"

# ── Auth.js (NextAuth v5) ─────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"

# ── Google OAuth ──────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ── Email (Resend) ────────────────────────────────────────────
# Sign up at https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="noreply@lettervault.com"

# ── AWS S3 (letter file storage) ──────────────────────────────
# Create an S3 bucket and an IAM user with PutObject / GetObject / DeleteObject
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="lettervault-letters"

# ── Encryption (AES-256-GCM for confidential letters) ─────────
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="your-32-byte-base64-encoded-key-here"
